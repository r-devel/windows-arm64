+// The libc++ in rtools45-aarch64 (clang 19) does not implement std::from_chars for double
+#if defined(_LIBCPP_VERSION)
+#include <cerrno>
+#include <cstdlib>
+#include <string>
+static std::from_chars_result from_chars_double(const char* first, const char* last, double& value) {
+    std::string buf(first, last);
+    const char* s = buf.c_str();
+    if (buf.empty() || std::isspace(static_cast<unsigned char>(s[0])) || s[0] == '+' ||
+        buf.find_first_of("xX") != std::string::npos) {
+        return {first, std::errc::invalid_argument};
+    }
+    char* end;
+    errno = 0;
+    double v = std::strtod(s, &end);
+    if (end == s) return {first, std::errc::invalid_argument};
+    if (errno == ERANGE) return {first + (end - s), std::errc::result_out_of_range};
+    value = v;
+    return {first + (end - s), std::errc{}};
+}
+#else
+#define from_chars_double std::from_chars
+#endif
+
