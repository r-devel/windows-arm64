diff --git a/ggsql/src/rust/build-env-win.sh b/ggsql/src/rust/build-env-win.sh
index 5777673..0eb6a37 100644
--- a/ggsql/src/rust/build-env-win.sh
+++ b/ggsql/src/rust/build-env-win.sh
@@ -5,3 +5,17 @@
 # flag text does not land in 00install.out and trip R CMD check's
 # non-portable-flag scan.
 export CXXFLAGS="${CXXFLAGS} -Wa,-mbig-obj"
+
+# On Windows arm64 the host rustc triple is aarch64-pc-windows-msvc, and
+# cargo compiles build scripts (libduckdb-sys -> reqwest -> rustls -> ring)
+# for that host triple. ring's build.rs hardcodes clang as its C compiler on
+# Windows aarch64, but the clang shipped with Rtools (llvm-mingw) has no MSVC
+# sysroot, so <assert.h> is not found. cc-rs appends per-target env CFLAGS
+# after its own flags, so this trailing --target wins and redirects those
+# host-only objects to the mingw sysroot that Rtools clang does have; the
+# resulting COFF objects link fine into the build-script executables.
+# Skipped when a real MSVC environment (INCLUDE) is available.
+host_triple=$(rustc -vV 2>/dev/null | sed -n 's/^host: //p')
+if [ "$host_triple" = "aarch64-pc-windows-msvc" ] && [ -z "${INCLUDE}" ]; then
+  export CFLAGS_aarch64_pc_windows_msvc="--target=aarch64-w64-mingw32"
+fi
diff --git a/ggsql/tools/config.R b/ggsql/tools/config.R
index d2231a5..a5827ee 100644
--- a/ggsql/tools/config.R
+++ b/ggsql/tools/config.R
@@ -9,7 +9,7 @@ env_debug <- Sys.getenv("DEBUG")
 env_not_cran <- Sys.getenv("NOT_CRAN")
 
 # check if the vendored zip file exists
-vendor_exists <- file.exists("src/rust/vendor.tar.xz")
+vendor_exists <- FALSE
 
 is_not_cran <- env_not_cran != ""
 is_debug <- env_debug != ""
@@ -63,6 +63,23 @@ cfg <- if (is_debug) "debug" else "release"
 # there may be use cases later where this can be adapted or expanded
 .target <- ifelse(is_wasm, paste0("--target=", webr_target), "")
 
+# used to replace @WIN_TARGET@ in Makevars.win.in. R on Windows arm64
+# (aarch64-w64-mingw32) uses the llvm-mingw toolchain, which maps to the
+# gnullvm Rust target; x86_64/i686 keep deriving the -gnu target from $(WIN).
+.windows_target <- if(grepl("aarch", R.version$platform)){
+  "aarch64-pc-windows-gnullvm"
+} else if(grepl("clang", Sys.getenv('R_COMPILED_BY'))){
+  "x86_64-pc-windows-gnullvm"
+} else if(grepl("i386", R.version$platform)){
+  "i686-pc-windows-gnu"
+} else {
+  "x86_64-pc-windows-gnu"
+}
+# used to replace @CXX_RUNTIME@ in Makevars.win.in: the DuckDB C++ objects
+# inside libggsql.a need the C++ runtime at link time. Rtools on arm64 is
+# llvm-mingw, which ships libc++ instead of libstdc++.
+.cxx_runtime <- ifelse(grepl('gnullvm', .windows_target), "-lc++", "-lstdc++")
+
 # add panic exports only for WASM builds
 .panic_exports <- ifelse(
   is_wasm,
@@ -172,6 +189,8 @@ new_txt <- gsub("@CRAN_FLAGS@", .cran_flags, mv_txt) |>
   gsub("@CLEAN_TARGET@", .clean_targets, x = _) |>
   gsub("@LIBDIR@", .libdir, x = _) |>
   gsub("@TARGET@", .target, x = _) |>
+  gsub("@WIN_TARGET@", .windows_target, x = _, fixed = TRUE) |>
+  gsub("@CXX_RUNTIME@", .cxx_runtime, x = _, fixed = TRUE) |>
   gsub("@PANIC_EXPORTS@", .panic_exports, x = _) |>
   gsub("@MACOSX_TARGET@", .macos_target, x = _) |>
   gsub("@ODBC_LIBS@", .odbc_libs, x = _)
